{% comment %}
  Academic service renderer. Each role is shown on one line and the
  journal or journal list is shown directly underneath it.
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item">
      <div class="service-entry">
        {% if entry.logo %}
          <div class="service-logo">
            <img src="{{ entry.logo | relative_url }}" alt="{{ entry.organization }} logo">
          </div>
        {% endif %}
        <div class="service-content">
          <h6 class="title font-weight-bold mb-1">{{ entry.title }}</h6>
          {% if entry.organization %}
            <div>{{ entry.organization }}</div>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
